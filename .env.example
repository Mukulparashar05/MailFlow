# ============================================================
# OutBox - Email Campaign Scheduler
# Environment Variables
# ============================================================
# Copy this file to backend/.env and fill in your values

# --- Database (PostgreSQL) ---
# Matches the credentials in docker-compose.yml
DATABASE_URL="postgresql://outbox:outbox_password@localhost:5432/outbox_db"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Google OAuth 2.0 ---
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# --- Session ---
# Generate a secure random string for production
SESSION_SECRET=change_this_to_a_secure_random_string

# --- SMTP Configuration ---
# For development: use https://ethereal.email/
# For production: use Gmail, SendGrid, AWS SES, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM="OutBox <your_email@gmail.com>"

# --- Resend API (optional, used in production) ---
# When set, emails are sent through Resend's HTTP API instead of SMTP.
# Needed on hosts that block outbound SMTP ports (e.g. Railway).
# SMTP_FROM must then be a Resend sender, e.g. "MailFlow <onboarding@resend.dev>"
# RESEND_API_KEY=re_your_resend_api_key

# --- Worker Configuration ---
WORKER_CONCURRENCY=5

# --- Rate Limiting ---
# Window in seconds: 60 = per minute (default, matches the UI), 3600 = per hour
RATE_LIMIT_WINDOW_SECONDS=60

# --- URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# --- Environment ---
NODE_ENV=development
PORT=3001

# --- Frontend (frontend/.env, optional) ---
# Leave VITE_API_URL unset: locally the Vite dev proxy forwards /api and /auth,
# and on Vercel frontend/vercel.json rewrites them to the backend.
# VITE_API_URL=
# Suggested recipient on the Compose page ("" disables the demo-mode hint)
# VITE_DEMO_RECIPIENT=
