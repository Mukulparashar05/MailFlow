# ============================================================
# OutBox - Email Campaign Scheduler
# Environment Variables
# ============================================================
# Copy this file to backend/.env and fill in your values

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/outbox_db"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Google OAuth 2.0 ---
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# --- Session ---
# Generate a secure random string for production
SESSION_SECRET=change_this_to_a_secure_random_string

# --- SMTP Configuration ---
# For development: use https://ethereal.email/
# For production: use Gmail, SendGrid, AWS SES, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM="OutBox <your_email@gmail.com>"

# --- Worker Configuration ---
WORKER_CONCURRENCY=5

# --- Rate Limiting ---
# Window in seconds: 3600 = 1 hour (default), 60 = 1 minute (testing)
# RATE_LIMIT_WINDOW_SECONDS=3600

# --- URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# --- Frontend Environment (set in Vercel) ---
# VITE_API_URL=https://your-backend-url.com

# --- Environment ---
NODE_ENV=development
PORT=3001
